# Copy to .env and fill in. .env is gitignored and is read by both the
# conversion scripts in tools/ and by app.R at startup.
#
# app.R does not require this file: any variable already present in the
# environment wins, so a deployment can set these as real environment
# variables and ship no .env at all.

AWS_ENDPOINT_URL = https://taiga-dtn-s3.ncsa.illinois.edu:51019
AWS_ACCESS_KEY_ID = your-access-key
AWS_SECRET_ACCESS_KEY = your-secret-key
BUCKET_NAME = your-bucket

# Optional, shown with their defaults:
# PARQUET_PREFIX = sfgc/parquet
# AWS_DEFAULT_REGION = us-east-1
